+    private fun createBoundSocket(protocol: Int, source: InetSocketAddress, target: InetSocketAddress): Int {
+        // Only handle TCP for now; UDP fallback to -1 (native will dial normally)
+        val IPPROTO_TCP = 6
+        val IPPROTO_UDP = 17
+        if (protocol != IPPROTO_TCP) {
+            return -1
+        }
+
+        try {
+            val cm = connectivity
+
+            val chosenNetwork = run {
+                val active = cm.activeNetwork
+                val nc = cm.getNetworkCapabilities(active)
+                if (active != null && nc != null && nc.hasTransport(android.net.NetworkCapabilities.TRANSPORT_CELLULAR)) {
+                    active
+                } else {
+                    cm.allNetworks.firstOrNull { n -> cm.getNetworkCapabilities(n)?.hasTransport(android.net.NetworkCapabilities.TRANSPORT_CELLULAR) == true }
+                }
+            } ?: return -1
+
+            val socket = chosenNetwork.socketFactory.createSocket() as java.net.Socket
+
+            try {
+                socket.connect(target, 2000)
+            } catch (e: Exception) {
+                try { socket.close() } catch (_: Exception) {}
+                return -1
+            }
+
+            val pfd = android.os.ParcelFileDescriptor.fromSocket(socket)
+            val fd = pfd.detachFd()
+
+            // Protect the socket from VPN
+            try {
+                vpn.protect(fd)
+            } catch (e: Exception) {
+                try { socket.close() } catch (_: Exception) {}
+                return -1
+            }
+
+            return fd
+        } catch (e: Exception) {
+            return -1
+        }
+    }
+
     suspend fun close() {
         close.send(Unit)
     }
