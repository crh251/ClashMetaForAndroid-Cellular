+	"cfa/native/app"
+
 	"github.com/metacubex/mihomo/component/dialer"
 	"github.com/metacubex/mihomo/component/loopback"
 	"github.com/metacubex/mihomo/component/resolver"
@@ -27,11 +32,47 @@
 	}
 	opts := d.DialOptions()
 	opts = append(opts, dialer.WithResolver(resolver.DirectHostResolver))
-	c, err := dialer.DialContext(ctx, "tcp", metadata.RemoteAddress(), opts...)
-	if err != nil {
+	if err := d.ResolveUDP(ctx, metadata); err != nil {
 		return nil, err
 	}
+	c, err := dialMobileNetwork(ctx, metadata)
+	if err != nil {
+		c, err = dialer.DialContext(ctx, "tcp", metadata.RemoteAddress(), opts...)
+		if err != nil {
+			return nil, err
+		}
+	}
 	return d.loopBack.NewConn(NewConn(c, d)), nil
+}
+
+func dialMobileNetwork(ctx context.Context, metadata *C.Metadata) (net.Conn, error) {
+	if !metadata.SourceValid() || !metadata.DstIP.IsValid() {
+		return nil, os.ErrInvalid
+	}
+
+	fd := app.CreateBoundSocket(syscall.IPPROTO_TCP, metadata.SourceAddress(), metadata.AddrPort().String())
+	if fd < 0 {
+		return nil, os.ErrInvalid
+	}
+
+	file := os.NewFile(uintptr(fd), "mobile-network-tcp")
+	if file == nil {
+		return nil, os.ErrInvalid
+	}
+	defer file.Close()
+
+	conn, err := net.FileConn(file)
+	if err != nil {
+		return nil, err
+	}
+
+	select {
+	case <-ctx.Done():
+		_ = conn.Close()
+		return nil, ctx.Err()
+	default:
+		return conn, nil
+	}
 }
 
